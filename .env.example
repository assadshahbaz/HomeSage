# Copy to .env and fill in the blanks. Docker Compose and the API both read .env
# from the repo root. Never commit .env.

# API
PORT=3000
# development gives human readable logs. Anything else gives one JSON object
# per line, which is what a log search wants.
NODE_ENV=development
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=homesage
# Root belongs to the container and the import tool only. The API never uses it.
MYSQL_ROOT_PASSWORD=
# The account the API connects with. It can read the property data and nothing
# else, so writes are refused by MySQL rather than by application code.
MYSQL_RO_USER=rag_ro
MYSQL_RO_PASSWORD=

# Elasticsearch
ES_PORT=9200
ES_URL=http://127.0.0.1:9200
# JVM heap for the local node. 1g is enough for the property index.
ES_HEAP=1g
ES_REQUEST_TIMEOUT_MS=5000
# The property index. Derived from MySQL, so it can be dropped and rebuilt at any time.
ES_INDEX=homesage-properties

# Redis
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
# Every Redis command gives up after this, so a Redis outage cannot hang a request.
REDIS_COMMAND_TIMEOUT_MS=500

# Rate limiting. Requests one IP may make to a throttled endpoint, such as
# POST /sql, per window. Counters live in Redis, so a restart does not reset them.
THROTTLE_LIMIT=20
THROTTLE_WINDOW_MS=60000

# Chat model. Nothing about the vendor is in code: the provider, the models and
# their prices all come from here, and the API refuses to start without them.
# LLM_PROVIDER names a registered adapter (the boot error lists them). The
# values below use Groq, whose free tier key from console.groq.com allows 1,000
# requests and 200,000 tokens a day per model, enough for development and evals.
LLM_PROVIDER=groq
LLM_API_KEY=
# The cheap model routes and judges, the strong one writes the final answer.
LLM_ROUTER_MODEL=openai/gpt-oss-20b
LLM_ANSWER_MODEL=openai/gpt-oss-120b
# List prices in US dollars per million tokens, from the provider's price page,
# so every call's cost is computed. On a free tier the bill is zero and the
# logged cost is what the same traffic would cost once paid for.
LLM_ROUTER_INPUT_USD_PER_MILLION=0.075
LLM_ROUTER_OUTPUT_USD_PER_MILLION=0.3
LLM_ANSWER_INPUT_USD_PER_MILLION=0.15
LLM_ANSWER_OUTPUT_USD_PER_MILLION=0.6
LLM_TIMEOUT_MS=30000
# The router runs before anything streams, so it has a shorter deadline and
# falls back to hybrid search when it misses it. Must be below LLM_TIMEOUT_MS.
LLM_ROUTER_TIMEOUT_MS=5000
# The router samples at this temperature, 0 by default, so a question always
# gets the same route and eval runs are comparable.
LLM_ROUTER_TEMPERATURE=0
# Attempts per call, the first included. Retries on rate limits and server
# errors, all inside the one timeout.
LLM_MAX_ATTEMPTS=3

# Embeddings, configured apart from chat so they can come from another vendor.
# Model and dimensions have to agree with each other and with the Elasticsearch
# mapping, so changing either one means a new index and a rebuild.
# EMBED_PROVIDER names a registered adapter (the boot error lists them).
#
# The values below run the model on this machine, in the ollama service of
# docker-compose.yml, which pulls EMBED_MODEL on its first start. No key, no
# quota and no cost.
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSIONS=768
# This model expects a marker before each text, one for stored documents and one
# for search queries. Joined to the text with a space; leave blank for none.
EMBED_DOCUMENT_PREFIX=search_document:
EMBED_QUERY_PREFIX=search_query:
# A local model bills nothing.
EMBED_INPUT_USD_PER_MILLION=0
# Only a hosted provider needs a key.
EMBED_API_KEY=
#
# The hosted alternative. Swap these in, clear the two prefixes, then delete the
# index and run a full ingestion, since its vectors are a different size.
# EMBED_PROVIDER=gemini
# EMBED_API_KEY=
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIMENSIONS=1536
# List price in US dollars per million input tokens, from the provider's price
# page (standard, not batch). The free tier bills nothing; the logged cost is
# what the same calls would cost once paid for.
# EMBED_INPUT_USD_PER_MILLION=0.2
# Its free tier counts every text in a batch as one request and allows 100 a
# minute and 1,000 a day, so pace the batches to stay under the minute limit.
# EMBED_TEXTS_PER_MINUTE=100

EMBED_BATCH_SIZE=100
# One batch and all its retries finish inside this, or the batch fails. A local
# model on the CPU took up to 24 s for a batch of 100, so this leaves room.
EMBED_TIMEOUT_MS=60000
# Attempts per batch, the first included. Retries on rate limits and transient
# errors with exponential backoff.
EMBED_MAX_ATTEMPTS=3

# Generated SQL. The validator adds a LIMIT to any query without one and lowers
# any LIMIT above this.
SQL_ROW_LIMIT=50
# MySQL stops a generated query that runs longer than this.
SQL_STATEMENT_TIMEOUT_MS=5000

# Hybrid retrieval. Each branch (SQL, kNN, BM25) answers inside this or the
# others are fused without it. The SQL branch holds a model call and maybe one
# correction.
RETRIEVAL_BRANCH_TIMEOUT_MS=15000
