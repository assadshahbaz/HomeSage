# Copy to .env and fill in the blanks. The server checks every value at boot
# and refuses to start with anything missing or malformed, naming the variable.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
# HomeSage's API uses 3000, so this one defaults to 3100.
PORT=3100

# Where HomeSage's API is running. Start HomeSage first (see its README).
HOMESAGE_URL=http://127.0.0.1:3000
# HomeSage usually answers in a few seconds; the caller hears a holding line meanwhile.
HOMESAGE_TIMEOUT_MS=15000

# Shared with Vapi, which sends it on every webhook. At least 24 characters.
# Make one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VOICE_WEBHOOK_SECRET=
# Bearer token for the /admin endpoints, which show callers' details. At least 24 characters.
ADMIN_TOKEN=

# SQLite file for viewings, leads, messages and call transcripts. Git ignores data/.
DB_PATH=data/voice.db

# ---------------------------------------------------------------------------
# The agency
# ---------------------------------------------------------------------------
AGENCY_NAME=HomeSage Estates
AGENCY_TIMEZONE=Europe/London

# Viewing diary. Days are 0 for Sunday to 6 for Saturday.
VIEWING_DAYS=1,2,3,4,5,6
VIEWING_START=10:00
VIEWING_END=17:00
VIEWING_SLOT_MINUTES=30
VIEWING_DAYS_AHEAD=14
VIEWING_SLOTS_OFFERED=4

# Optional. A Slack incoming webhook, or a Make, n8n or Zapier hook, told about
# every booking, valuation request and message as it happens.
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_MS=5000

# How long the server remembers a call's homes if its end of call report never arrives.
CALL_MEMORY_TTL_MINUTES=120

# ---------------------------------------------------------------------------
# Vapi (read only by `npm run vapi:sync`, never by the server)
# ---------------------------------------------------------------------------
# Your private API key, from the Vapi dashboard under API Keys.
VAPI_API_KEY=
VAPI_ASSISTANT_NAME=HomeSage Voice
# The public https address of this server, such as your ngrok URL.
PUBLIC_URL=
# Optional. A Vapi custom credential (Bearer Token type) holding VOICE_WEBHOOK_SECRET.
# Without one, the sync sends the secret as an X-Vapi-Secret header instead.
VAPI_CREDENTIAL_ID=
# Any model Vapi lists. A fast one keeps the gap after the caller speaks short.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4.1-mini
# Optional. Leave both blank to keep Vapi's default voice, or whatever you pick in the dashboard.
VAPI_VOICE_PROVIDER=
VAPI_VOICE_ID=
# Optional. The office number in E.164, such as +441632960999. When set, the
# agent can transfer callers who ask for a person; when blank, it takes a message.
TRANSFER_PHONE_NUMBER=
